# HTTPS local para probar GPS desde el celular
LAN_IP=192.168.1.25

# Email opcional. Si queda vacío, las suscripciones se guardan pero no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# IA opcional. Sin clave, la app usa clasificación local de respaldo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Modo presentación listo para usar
DEMO_MODE=1
DEMO_ADMIN_PASSWORD=CiudadVisible2026!
DEMO_RIVERA_USER=rivera
DEMO_LIVRAMENTO_USER=livramento

# Producción / Render: URL de PostgreSQL. En local puede quedar vacía y usa SQLite.
DATABASE_URL=
