# HTTPS local para probar GPS desde el celular
LAN_IP=192.168.1.25

# Email opcional. Si queda vacío, las suscripciones se guardan pero no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# IA opcional. Sin clave, la app usa clasificación local de respaldo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Demo solo local: requiere una contraseña propia de al menos 12 caracteres
DEMO_MODE=0
DEMO_ADMIN_PASSWORD=
DEMO_RIVERA_USER=rivera
DEMO_LIVRAMENTO_USER=livramento

# Producción / Render: URL de PostgreSQL. En local puede quedar vacía y usa SQLite.
DATABASE_URL=

SESSION_HOURS=12
INCIDENT_RATE_LIMIT=10
DB_POOL_SIZE=8
AI_TIMEOUT_SECONDS=8
TRUST_PROXY_HOPS=0
SENTRY_DSN=
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0

# Opcional: directorio persistente para fotos (Docker: /data/photos).
PHOTOS_DIR=
# Embeddings locales: instalar requirements-local-ai.txt y preparar el modelo.
LOCAL_EMBED_MODEL=

# Excepción explícita para demostraciones alojadas; requiere contraseña propia.
ALLOW_PUBLIC_DEMO=0
